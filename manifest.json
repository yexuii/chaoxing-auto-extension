{
  "manifest_version": 3,
  "name": "超星学习通自动倍速与任务点助手 (MAX动态档位版)",
  "short_name": "超星倍速助手",
  "version": "1.2.0",
  "description": "支持 [1-16x] 自由调速、MAX 动态极速档位（基于25%真实观看时长安全阈值动态控速+16x冲刺）、Alt+S 开关、视频/PPT/PDF 任务点自动完成与自动下一节。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "超星学习通自动倍速与任务点助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.edu.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/mycourse/studentstudy*",
        "*://*.edu.cn/mycourse/studentstudy*"
      ],
      "js": [
        "page-controller.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.chaoxing.com/mycourse/studentstudy*",
        "*://*.edu.cn/mycourse/studentstudy*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-controller.js"
      ],
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.edu.cn/*"
      ]
    }
  ]
}
